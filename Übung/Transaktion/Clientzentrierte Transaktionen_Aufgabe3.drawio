        <mxCell id="H-_a-v-MUJt0tzvwUelt-244" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="- Keine strikte Konsistenz zwischen den Replika&lt;div&gt;- Read your Own Write Verletzung bei t = 0.5&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;-&amp;gt; Davor wurde der Wert x = 5 geschrieben&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;-&amp;gt; gelesen wird x = 0&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
